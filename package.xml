<?xml version="1.0"?>
<package format="3">
  <name>multiwii</name>
  <version>2.2.0</version>
  <description>C++17 ROS 2 MultiWii/Cleanflight/Betaflight bridge with controller state and MSP emulator</description>
  <maintainer email="Rauch.Christian@gmx.de">Christian Rauch</maintainer>
  <author email="Rauch.Christian@gmx.de">Christian Rauch</author>
  <license>BSD</license>
  <license>LGPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <build_depend>libasio-dev</build_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
